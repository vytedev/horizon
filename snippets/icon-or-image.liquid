{%- comment -%}
  Renders an icon or image
  
  @param {string} icon - Icon name (e.g., 'check_box', 'star', 'price_tag')
  @param {image} image_upload - Optional uploaded image
  @param {number} width - Icon width in pixels
  @param {string} class_name - CSS class name
  @param {string} attributes - Additional HTML attributes
{%- endcomment -%}

{%- liquid
  assign icon_name = icon | default: ''
  assign icon_width = width | default: 24
  assign icon_class = class_name | default: ''
  assign icon_attributes = attributes | default: ''
-%}

{%- if image_upload != blank -%}
  {%
    render 'image',
    image: image_upload,
    width: icon_width,
    class: icon_class,
    attributes: icon_attributes
  %}
{%- elsif icon_name != blank and icon_name != 'none' -%}
  <svg
    class="{{ icon_class }}"
    width="{{ icon_width }}"
    height="{{ icon_width }}"
    viewBox="0 0 20 20"
    fill="currentColor"
    stroke="currentColor"
    style="color: var(--color-foreground, currentColor);"
    xmlns="http://www.w3.org/2000/svg"
    {{ icon_attributes }}
    aria-hidden="true"
    focusable="false"
    role="img"
  >
    {%- render 'icon', icon: icon_name -%}
  </svg>
{%- endif -%}
