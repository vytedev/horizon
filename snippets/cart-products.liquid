<script
  src="{{ 'component-cart-items.js' | asset_url }}"
  type="module"
></script>

<div
  {{ block.shopify_attributes }}
  class="cart-items__wrapper"
  {% if settings.product_title_case == 'uppercase' %}
    style="--product-title-case: uppercase;"
  {% endif %}
>
  {% if cart.empty? %}
    {%- if shop.customer_accounts_enabled and customer == null -%}
      <p>
        {{ 'actions.log_in_html' | t: link: routes.account_login_url }}
      </p>
    {%- endif -%}

    <a
      class="button cart-items__empty-button"
      href="{{ routes.all_products_collection_url }}"
    >
      {{ 'actions.continue_shopping' | t }}
    </a>
  {%- else -%}
    <span
      class="visually-hidden"
      ref="cartItemCount"
      aria-hidden="true"
    >
      {{- cart.item_count -}}
    </span>
    <form
      action="{{ routes.cart_url }}"
      class="cart-form"
      id="cart-form"
      method="post"
    >
      <div
        class="cart-items spacing-style{% if block.settings.dividers %} cart-items--dividers{% endif %}"
        style="{%  render 'spacing-style', settings: block.settings %} --cart-items-gap:{{ block.settings.gap | append: "px" }};"
      >
        <table
          class="cart-items__table"
          role="table"
        >
          <caption
            class="visually-hidden"
            role="caption"
          >
            {{ 'content.cart_total' | t }}
            <span>{{ cart.total_price | money_with_currency }}</span>
          </caption>

          <thead
            class="cart-items__table-head"
            role="rowgroup"
          >
            <tr
              role="row"
              class="cart-items__table-row cart-items__table-row--header"
            >
              <th
                id="productImage"
                scope="col"
                role="columnheader"
                class="cart-items__table-header cart-items__table-header--image"
              >
                <p></p>
              </th>
              <th
                id="productInformation"
                scope="col"
                role="columnheader"
                class="cart-items__table-header cart-items__table-header--product-name"
              >
                <p>PRODUCT NAME</p>
              </th>
              <th
                id="unitPrice"
                scope="col"
                role="columnheader"
                class="cart-items__table-header cart-items__table-header--unit-price"
              >
                <p>UNIT PRICE</p>
              </th>
              <th
                id="quantity"
                scope="col"
                role="columnheader"
                class="cart-items__table-header cart-items__table-header--quantity"
              >
                <p>QUANTITY</p>
              </th>
              <th
                id="productTotal"
                scope="col"
                role="columnheader"
                class="cart-items__table-header cart-items__table-header--total"
              >
                <p>TOTAL</p>
              </th>
              <th
                id="removeItem"
                scope="col"
                role="columnheader"
                class="cart-items__table-header cart-items__table-header--remove"
              >
                <p></p>
              </th>
            </tr>
          </thead>

          <tbody role="rowgroup">
            {% for item in cart.items %}
              <tr
                role="row"
                class="cart-items__table-row"
                ref="cartItemRows[]"
              >
                <td
                  class="cart-items__media"
                  role="cell"
                  headers="productImage"
                >
                  {% if item.image -%}
                    {% liquid
                      assign ratio = 1
                      if block.settings.image_ratio == 'portrait'
                        assign ratio = 0.8
                      elsif block.settings.image_ratio == 'adapt'
                        assign ratio = item.image.aspect_ratio
                      endif
                    %}
                    <a
                      href="{{ item.url }}"
                      class="cart-items__media-container"
                      style="--ratio:{{ ratio }};"
                    >
                      {%- liquid
                        echo item.image | image_url: width: 250 | image_tag: class: 'cart-items__media-image'
                      -%}
                    </a>
                  {%- endif %}
                </td>
                <td
                  class="cart-items__details cart-primary-typography"
                  role="cell"
                  headers="productInformation"
                >
                  {% comment %} Group product name and price for cart drawer {% endcomment %}
                  <div class="cart-items__details-content">
                    <p>
                      <a
                        href="{{ item.url }}"
                        class="cart-items__title"
                      >
                        {{- item.product.title -}}
                      </a>
                    </p>
                    {% comment %} Total price - only show in cart drawer, grouped with product name {% endcomment %}
                    {%- liquid
                      if settings.currency_code_enabled_cart_items
                        assign price = item.final_line_price | money_with_currency
                      else
                        assign price = item.final_line_price | money
                      endif
                    -%}
                    <div class="cart-items__price-group--drawer">
                      <div class="cart-items__price--drawer cart-secondary-typography">
                        <text-component value="{{ price | strip_html }}">{{ price }}</text-component>
                      </div>
                      {% if item.line_level_discount_allocations.size > 0 %}
                        <span class="cart-items__voucher-check">
                          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="#ff6b35">
                            <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82Z"/>
                            <path d="M7 7h.01" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                            <path d="M9 12l2 2 4-4" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                          </svg>
                        </span>
                      {% endif %}
                    </div>
                  </div>
                  {% if item.product.vendor and block.settings.vendor %}
                    <p>
                      {{ item.product.vendor }}
                    </p>
                  {% endif %}

                  {%- if item.item_components.size != 0 -%}
                    <ul class="cart-items__bundle list-unstyled">
                      {%- for component in item.item_components -%}
                        <li>
                          {{- component.title -}}
                          {%- if component.quantity > 1 -%}
                            <span> × {{ component.quantity }}</span>
                          {%- endif -%}
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}

                  {%- if item.product.has_only_default_variant == false
                    or item.properties.size != 0
                    or item.selling_plan_allocation != null
                  -%}
                    <dl class="cart-items__variants">
                      {%- if item.product.has_only_default_variant == false and item.item_components.size == 0 -%}
                        {%- for option in item.options_with_values -%}
                          <div class="cart-items__variant">
                            <dt class="visually-hidden">{{ option.name }}:</dt>
                            <dd>
                              {{- option.value -}}
                              {%- if forloop.last != true %},&nbsp;{% endif -%}
                            </dd>
                          </div>
                        {%- endfor -%}
                      {%- endif -%}

                      {%- for property in item.properties -%}
                        {%- assign property_first_char = property.first | slice: 0 -%}
                        {%- if property.last != blank and property_first_char != '_' -%}
                          <div class="cart-items__properties">
                            <dt>{{ property.first }}:</dt>
                            <dd>
                              {%- if property.last contains '/uploads/' -%}
                                <a href="{{ property.last }}">{{ property.last | split: '/' | last }}</a>
                              {%- else -%}
                                {{ property.last }}
                              {%- endif -%}
                            </dd>
                          </div>
                        {%- endif -%}
                      {%- endfor -%}
                    </dl>

                    {% if item.selling_plan_allocation %}
                      <p>{{ item.selling_plan_allocation.selling_plan.name }}</p>
                    {% endif %}
                  {%- endif -%}

                  {% comment %} Unit price - only show in cart drawer, hidden in cart page {% endcomment %}
                  <div class="cart-items__unit-price--drawer">
                    {% if item.original_price != item.final_price %}
                      <span class="visually-hidden">{{ 'content.price_sale' | t }}</span>
                      <span>{{ item.final_price | money }}</span>
                      <span class="visually-hidden">{{ 'content.price_regular' | t }}</span>
                      <s class="compare-at-price">
                        {% if item.variant.compare_at_price > item.original_price %}
                          {{ item.variant.compare_at_price | money }}
                        {% else %}
                          {{ item.original_price | money }}
                        {% endif %}
                      </s>
                    {% else %}
                      {% if item.variant.compare_at_price > item.original_price %}
                        <span class="visually-hidden">{{ 'content.price_sale' | t }}</span>
                      {% else %}
                        <span class="visually-hidden">{{ 'content.price' | t }}</span>
                      {% endif %}

                      <span>{{ item.original_price | money }}</span>

                      {% if item.variant.compare_at_price > item.original_price %}
                        <span class="visually-hidden">{{ 'content.price_regular' | t }}</span>
                        <s class="compare-at-price">{{ item.variant.compare_at_price | money }}</s>
                      {% endif %}
                    {% endif %}
                  </div>

                </td>
                <td
                  class="cart-items__unit-price-cell"
                  role="cell"
                  headers="unitPrice"
                >
                  {% comment %} Unit price - only show in cart page {% endcomment %}
                  <div class="cart-items__unit-price--page">
                    {% if item.original_price != item.final_price %}
                      <span class="visually-hidden">{{ 'content.price_sale' | t }}</span>
                      <span>{{ item.final_price | money }}</span>
                      <span class="visually-hidden">{{ 'content.price_regular' | t }}</span>
                      <s class="compare-at-price">
                        {% if item.variant.compare_at_price > item.original_price %}
                          {{ item.variant.compare_at_price | money }}
                        {% else %}
                          {{ item.original_price | money }}
                        {% endif %}
                      </s>
                    {% else %}
                      {% if item.variant.compare_at_price > item.original_price %}
                        <span class="visually-hidden">{{ 'content.price_sale' | t }}</span>
                      {% else %}
                        <span class="visually-hidden">{{ 'content.price' | t }}</span>
                      {% endif %}

                      <span>{{ item.original_price | money }}</span>

                      {% if item.variant.compare_at_price > item.original_price %}
                        <span class="visually-hidden">{{ 'content.price_regular' | t }}</span>
                        <s class="compare-at-price">{{ item.variant.compare_at_price | money }}</s>
                      {% endif %}
                    {% endif %}
                  </div>
                </td>
                <td
                  class="cart-items__quantity"
                  role="cell"
                  headers="quantity"
                >
                  {% # Here I want to pass some arguments to the quantity block so it knows which value should the input be set to. Though quantity block could be a snippet instead %}
                  {% render 'quantity-selector',
                    product: item.product,
                    in_cart_quantity: item.quantity,
                    line_index: item.index,
                    min: 0,
                    class: 'cart-primary-typography'
                  %}
                </td>
                <td
                  class="cart-items__error hidden"
                  role="cell"
                  ref="cartItemErrorContainer-{{ item.index | plus: 1 }}"
                  headers="quantity"
                >
                  <div
                    class="cart-item__error"
                    role="alert"
                  >
                    <span class="svg-wrapper">
                      {{- 'icon-error.svg' | inline_asset_content -}}
                    </span>
                    <small
                      class="cart-item__error-text cart-primary-typography"
                      ref="cartItemError-{{ item.index | plus: 1 }}"
                    ></small>
                  </div>
                </td>
                <td
                  class="cart-items__price cart-secondary-typography"
                  role="cell"
                  headers="productTotal"
                >
                  {%- liquid
                    if settings.currency_code_enabled_cart_items
                      assign price = item.final_line_price | money_with_currency
                      assign unit_price = item.unit_price | money_with_currency
                    else
                      assign price = item.final_line_price | money
                      assign unit_price = item.unit_price | money
                    endif
                  -%}
                  <text-component value="{{ price | strip_html }}">{{ price }}</text-component>
                  {%- if item.unit_price_measurement -%}
                    <div class="cart-items__price-unit cart-secondary-typography">
                      {% render 'unit-price', price: unit_price, measurement: item.unit_price_measurement %}
                    </div>
                  {%- endif -%}
                </td>
                <td
                  class="cart-items__remove-cell"
                  role="cell"
                  headers="removeItem"
                >
                  <button
                    class="button button--tertiary cart-items__remove"
                    type="button"
                    aria-label="{{ 'accessibility.remove_item' | t: title: item.title | escape }}"
                    on:click="/onLineItemRemove/{{ item.index | plus: 1 }}"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M3 6h18"/>
                      <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
                      <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
                      <line x1="10" y1="11" x2="10" y2="17"/>
                      <line x1="14" y1="11" x2="14" y2="17"/>
                    </svg>
                    <span class="visually-hidden">Remove</span>
                  </button>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      {% comment %} Upsell Section {% endcomment %}
      {%- liquid
        assign cart_variant_ids_array = ''
        for item in cart.items
          assign cart_variant_ids_array = cart_variant_ids_array | append: item.variant_id | append: ','
        endfor
        
        assign available_upsell_products = ''
        assign cleaner_kit_products = ''
        
        for product in collections.all.products
          assign product_variant_id = product.selected_or_first_available_variant.id
          assign variant_id_string = product_variant_id | append: ''
          assign variant_id_with_comma = variant_id_string | append: ','
          assign variant_in_cart = false
          
          # More accurate check: look for variant_id followed by comma to avoid substring matches
          if cart_variant_ids_array contains variant_id_with_comma
            assign variant_in_cart = true
          endif
          
          unless variant_in_cart
            if product.tags contains 'cleaner kit'
              assign cleaner_kit_products = cleaner_kit_products | append: product.handle | append: ','
            endif
            assign available_upsell_products = available_upsell_products | append: product.handle | append: ','
          endunless
        endfor
        
        assign cleaner_kit_handles = cleaner_kit_products | split: ','
        assign available_upsell_handles = available_upsell_products | split: ','
        
        if cleaner_kit_handles[0] != blank
          assign first_upsell_handle = cleaner_kit_handles[0]
        elsif available_upsell_handles[0] != blank
          assign first_upsell_handle = available_upsell_handles[0]
        else
          assign first_upsell_handle = blank
        endif
      -%}
      
      {% if first_upsell_handle != blank %}
        {% assign initial_upsell_product = all_products[first_upsell_handle] %}
        {% if initial_upsell_product != blank %}
          {%- liquid
            assign upsell_variant_id = initial_upsell_product.selected_or_first_available_variant.id
          -%}
          <div class="cart-upsell-divider"></div>
          <div class="cart-upsell-container">
            <div class="cart-upsell-header">
              <p class="cart-upsell-header-title">You might also like</p>
              <button type="button" class="cart-upsell-refresh-button" aria-label="Refresh upsell products">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/>
                  <path d="M21 3v5h-5"/>
                  <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/>
                  <path d="M3 21v-5h5"/>
                </svg>
              </button>
            </div>
            <div class="cart-upsell-item" data-upsell-product-id="{{ upsell_variant_id }}" data-initial-product-id="{{ initial_upsell_product.id }}">
              <label class="cart-upsell-checkbox-label">
                <div class="cart-upsell-content">
                  <div class="cart-upsell-image">
                    {% if initial_upsell_product.featured_image %}
                      <img 
                        src="{{ initial_upsell_product.featured_image | image_url: width: 100 }}" 
                        alt="{{ initial_upsell_product.title }}"
                        width="100"
                        height="100"
                        loading="lazy"
                        class="cart-upsell-product-image"
                      >
                    {% endif %}
                  </div>
                  <div class="cart-upsell-details">
                    <p class="cart-upsell-title">{{ initial_upsell_product.title }}</p>
                    <p class="cart-upsell-price">
                      {{ initial_upsell_product.selected_or_first_available_variant.price | money }}
                    </p>
                  </div>
                </div>
                <input 
                  type="checkbox" 
                  class="cart-upsell-checkbox" 
                  data-variant-id="{{ upsell_variant_id }}"
                  data-product-id="{{ initial_upsell_product.id }}"
                >
              </label>
              <div class="cart-upsell-loading" style="display: none;">
                <span class="cart-upsell-loading-text">Adding to cart...</span>
              </div>
            </div>
          </div>
        {% endif %}
      {% endif %}
    </form>
  {%- endif -%}
</div>

{% stylesheet %}
  .cart-items {
    container-name: cart-items;
    container-type: inline-size;
    width: 100%;
  }

  .cart-items-disabled {
    pointer-events: none;
  }

  .cart-items__table {
    width: 100%;
  }

  .cart-items__table * {
    margin: 0;
  }

  .cart-page .cart-items__table tbody tr:first-child {
    margin-top: var(--margin-lg);
  }

  .cart-items__table-row {
    --cart-item-price-width: 6rem;

    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(var(--cart-item-price-width), auto);
    grid-template-areas:
      'media details price'
      'media quantity price'
      'media error error';
    column-gap: var(--gap-md);
    align-items: start;
    padding-bottom: var(--cart-items-gap);
    margin-bottom: var(--margin-lg);
  }

  /* Cart drawer: remove price area from grid since it's now in details */
  .cart-drawer .cart-items__table-row {
    --cart-item-remove-width: var(--minimum-touch-target);
    grid-template-columns: 80px minmax(0, 1fr) var(--cart-item-remove-width);
    grid-template-areas:
      'media details remove'
      'media quantity remove'
      'media error remove';
  }

  /* Cart page specific styles - not for cart drawer */
  .cart-page .cart-items__table-row {
    --cart-item-price-width: 6rem;
    --cart-item-remove-width: var(--minimum-touch-target);
    --cart-item-media-width-min: 2rem;
    --cart-item-media-width-max: 5rem;

    grid-template-columns: clamp(2rem, 10cqi, 5rem) minmax(0, 1fr) minmax(var(--cart-item-price-width), auto) minmax(var(--cart-item-price-width), auto) var(--cart-item-remove-width);
    grid-template-areas:
      'media details unit-price price remove'
      'media quantity unit-price price remove'
      'media error error error remove';
    align-items: start;
  }

  .cart-page .cart-items__table-row--header {
    padding-bottom: var(--padding-md);
    margin-bottom: var(--margin-md);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border) !important;
  }

  /* Hide table headers in cart drawer */
  .cart-drawer .cart-items__table-head {
    display: none !important;
  }

  /* Show table headers on cart page */
  .cart-page .cart-items__table-head {
    display: table-header-group !important;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--margin-md);
  }

  .cart-page .cart-items__table-header {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    padding-top: var(--padding-sm);
    padding-bottom: var(--padding-sm);
    text-align: center;
  }

  .cart-page .cart-items__table-header p {
    font-family: var(--font-body--family);
    font-size: var(--font-body--size);
    font-weight: var(--font-body--weight);
    line-height: var(--font-body--line-height);
    letter-spacing: var(--font-body--letter-spacing);
    color: var(--color-foreground);
    margin: 0;
    text-transform: uppercase;
    text-align: center;
  }

  .cart-page .cart-items__table-header--image {
    grid-area: media;
  }

  .cart-page .cart-items__table-header--product-name {
    grid-area: details;
  }

  .cart-page .cart-items__table-header--total {
    grid-area: price;
  }

  .cart-page .cart-items__table-header--remove {
    grid-area: remove;
  }

  .cart-drawer .cart-items__remove-cell {
    grid-area: remove;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cart-page .cart-items__table-header--unit-price {
    display: flex;
    grid-area: unit-price;
  }

  .cart-page .cart-items__table-header--quantity {
    display: none;
  }

  html:active-view-transition-type(page-navigation) .cart-items__table-row {
    view-transition-name: none !important;
  }

  .cart-items__table-row.removing {
    overflow: hidden;
    animation: removeRow calc(var(--animation-speed) * 2) var(--animation-easing) forwards;
    animation-delay: var(--animation-speed);
  }

  @keyframes removeRow {
    0% {
      height: var(--row-height);
    }

    100% {
      opacity: 0;
      height: 0;
      padding-bottom: 0;
      margin-bottom: 0;
      border-color: transparent;
    }
  }

  .cart-items__table-row:last-child {
    padding-bottom: 0;
  }

  .cart-items--dividers .cart-items__table-row {
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--cart-items-gap);
  }

  .cart-items--dividers .cart-items__table-row:last-child {
    border-block-end: none;
    padding-block-end: 0;
    margin-bottom: 0;
  }

  .cart-items__details {
    grid-area: details;
    color: rgb(from var(--color-foreground) r g b / 70%);
  }

  /* Cart drawer: group product name and price in flex column */
  .cart-drawer .cart-items__details {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xs);
  }

  /* Hide price cell in cart drawer since it's now in details */
  .cart-drawer .cart-items__price {
    display: none !important;
  }

  /* Style the price in cart drawer details */
  .cart-drawer .cart-items__price--drawer {
    font-size: var(--cart-font-size--md);
    margin-top: var(--margin-2xs);
  }

  /* Group product name and price in cart drawer */
  .cart-drawer .cart-items__details-content {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xs);
  }

  /* Hide price in details content on cart page */
  .cart-page .cart-items__price--drawer {
    display: none;
  }

  .cart-page .cart-items__details {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  /* Hide unit price in details column on cart page */
  .cart-page .cart-items__unit-price--drawer {
    display: none;
  }

  /* Hide unit price in details column in cart drawer */
  .cart-drawer .cart-items__unit-price--drawer {
    display: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  /* Hide unit price column in cart drawer */
  .cart-items__unit-price-cell {
    display: none;
  }

  .cart-drawer .cart-items__unit-price-cell {
    display: none !important;
    visibility: hidden !important;
    position: absolute !important;
    width: 0 !important;
    height: 0 !important;
    padding: 0 !important;
    margin: 0 !important;
    overflow: hidden !important;
    grid-area: unset !important;
    grid-column: unset !important;
    grid-row: unset !important;
  }

  /* Show unit price column on cart page */
  .cart-page .cart-items__unit-price-cell {
    grid-area: unit-price;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .cart-page .cart-items__unit-price--page {
    text-align: center;
