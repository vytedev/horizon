{%- doc -%}
  Renders a contact form with name, email, phone, and comment fields.

  @param {object} settings - Block settings, required for the 'spacing-style' and 'size-style' snippets.
  @param {string} submit_button - HTML for the submit button, rendered via a `content_for` block.

  @example
  {% render 'contact-form', settings: block.settings, submit_button: content_for_submit_button %}
{%- enddoc -%}

<div
  class="
    contact-form
    spacing-style size-style
    {% if settings.inherit_color_scheme == false %}color-{{ settings.color_scheme }}{% endif %}
  "
  style="
    {% render 'spacing-style', settings: settings %}
    {% render 'size-style', settings: settings %}
  "
  {{ block.shopify_attributes }}
>
  {% assign form_id = block.id | default: section.id | prepend: 'ContactForm-' %}

  {%- form 'contact', id: form_id, class: 'contact-form__form' -%}
    {%- if form.errors -%}
      <div
        class="contact-form__error"
        tabindex="-1"
        autofocus
      >
        {{- 'icon-error.svg' | inline_asset_content -}}

        {{- form.errors.translated_fields.email | capitalize }}
        {{ form.errors.messages.email -}}
      </div>
    {%- endif -%}

    {%- if form.posted_successfully? -%}
      <div
        class="contact-form__success"
        tabindex="-1"
        autofocus
      >
        {{- 'icon-checkmark.svg' | inline_asset_content -}}
        {{- 'blocks.contact_form.post_success' | t -}}
      </div>
    {%- endif -%}

    <div class="contact-form__field">
      <input
        type="text"
        id="ContactForm-name"
        class="contact-form__input"
        autocomplete="name"
        name="contact[name]"
        value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
        placeholder=" "
      >
      <label
        class="contact-form__label"
        for="ContactForm-name"
      >
        {{- 'blocks.contact_form.name' | t -}}
      </label>
    </div>

    <div class="contact-form__field">
      <input
        type="email"
        id="ContactForm-email"
        class="contact-form__input"
        autocomplete="email"
        name="contact[email]"
        spellcheck="false"
        autocapitalize="off"
        value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
        aria-required="true"
        {% if form.errors contains 'email' %}
          aria-invalid="true"
          aria-describedby="ContactForm-email-error"
        {% endif %}
        placeholder=" "
      >
      <label
        class="contact-form__label"
        for="ContactForm-email"
      >
        {{- 'blocks.contact_form.email' | t -}}
        <span aria-hidden="true">*</span>
      </label>
    </div>

    <div class="contact-form__field">
      <textarea
        rows="1"
        id="ContactForm-body"
        class="contact-form__input contact-form__input--textarea"
        name="contact[body]"
        placeholder=" "
      >
        {{- form.body -}}
      </textarea>
      <label
        class="contact-form__label"
        for="ContactForm-body"
      >
        {{- 'blocks.contact_form.comment' | t -}}
      </label>
    </div>

    {{ submit_button }}
  {%- endform -%}
</div>

{% stylesheet %}
  .contact-form__form {
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg);
    background-color: var(--color-background);
    position: relative;
    z-index: 1;
  }

  .contact-form__field {
    position: relative;
    width: 100%;
    z-index: 1;
  }

  .contact-form__label {
    position: absolute;
    left: 0;
    top: var(--padding-md);
    color: var(--color-foreground);
    font-size: 0.875rem;
    pointer-events: none;
    transition: all 0.2s ease;
    transform-origin: left top;
    opacity: 0.7;
    z-index: 2;
  }

  .contact-form__input {
    width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--color-foreground);
    background-color: transparent;
    padding: var(--padding-md) 0;
    border-radius: 0;
    border: none;
    border-bottom: 1px solid var(--color-input-border);
    -webkit-font-smoothing: antialiased;
    transition: border-bottom-color 0.2s ease, padding-top 0.2s ease;
    position: relative;
    z-index: 1;
  }

  .contact-form__input:hover {
    border-bottom-color: var(--color-input-border) !important;
    background-color: transparent !important;
  }

  .contact-form__input:focus,
  .contact-form__input:not(:placeholder-shown) {
    outline: none;
    border-bottom-color: var(--color-foreground);
    padding-top: calc(var(--padding-md) + 0.875rem);
  }

  .contact-form__input:focus + .contact-form__label,
  .contact-form__input:not(:placeholder-shown) + .contact-form__label {
    top: 0.125rem;
    font-size: 0.75rem;
    transform: translateY(0);
    opacity: 1;
  }

  .contact-form__input--textarea {
    resize: vertical;
    min-height: auto;
    height: auto;
    line-height: 1.5;
    padding-top: var(--padding-md);
    padding-bottom: var(--padding-md);
    overflow-y: hidden;
  }

  .contact-form__input--textarea:focus {
    overflow-y: auto;
  }

  .contact-form__input--textarea:focus + .contact-form__label,
  .contact-form__input--textarea:not(:placeholder-shown) + .contact-form__label {
    top: 0.125rem;
    font-size: 0.75rem;
    transform: translateY(0);
    opacity: 1;
  }

  .contact-form__error,
  .contact-form__success {
    display: flex;
    align-items: center;
    gap: var(--gap-xs);
  }
{% endstylesheet %}
