      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Custom Product Card"
    },
    {
      "type": "product",
      "id": "custom_product_card_product",
      "label": "Product for Custom Card",
      "info": "This product will be displayed as an image-only card in the second row of the collection grid"
    }
