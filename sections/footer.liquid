<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
>
  {% liquid
    assign total_blocks = section.blocks.size

    # Grid layout calculations
    assign grid_columns = total_blocks | at_most: 4

    # Calculate last row counts using modulo arithmetic
    # last_row_count = (total_blocks - 1) % N + 1
    assign last_row_count = total_blocks | minus: 1 | modulo: 4 | plus: 1
    assign tablet_last_row_count = total_blocks | minus: 1 | modulo: 2 | plus: 1

    # Check if there are orphaned elements (single item in last row)
    assign has_isolated_grid_item_desktop = false
    assign has_isolated_grid_item_tablet = false

    if total_blocks > 4 and last_row_count == 1
      assign has_isolated_grid_item_desktop = true
    endif

    if total_blocks == 5
      assign has_isolated_grid_item_tablet = true
    endif
  %}
  <div
    class="
      footer-content
      spacing-style
      {% if has_isolated_grid_item_desktop %}footer-content--isolated-grid-item-desktop{% endif %}
      {% if has_isolated_grid_item_tablet %}footer-content--isolated-grid-item-tablet{% endif %}
    "
    style="
      {%  render 'spacing-style', settings: section.settings %}
      --footer-gap: {{ section.settings.gap }}px;
      --grid-columns: {{ grid_columns }};
      --last-row-count: {{ last_row_count }};
      --tablet-last-row-count: {{ tablet_last_row_count }};
    "
  >
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .footer-content {
    contain: content;
    content-visibility: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--footer-gap);
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .footer-content {
      grid-template-columns: repeat(min(var(--grid-columns), 3), 1fr);
      grid-auto-flow: row;
    }

    .footer-content[style*='--grid-columns: 4'] {
      grid-template-columns: repeat(2, 1fr);
    }

    .footer-content--isolated-grid-item-tablet > :last-child {
      grid-column: 1 / -1;
    }
  }

  @media screen and (min-width: 990px) {
    .footer-content {
      grid-template-columns: repeat(var(--grid-columns), 1fr);
    }

    /* Single item centered */
    .footer-content[style*='--grid-columns: 1'] {
      justify-items: center;
    }

    .footer-content--isolated-grid-item-desktop > :last-child {
      grid-column: 1 / -1;
    }
  }

  /* Make footer main group block 100% width */
  .footer-content > .group-block[data-testid="group-block"] {
    width: 100% !important;
    max-width: 100% !important;
    grid-column: 1 / -1 !important;
  }

  .footer-content > .group-block .group-block[data-testid="group-block"] {
    width: 100% !important;
    max-width: 100% !important;
  }

  /* Hide divider lines in footer */
  .footer-content .divider,
  .footer-content .divider__line {
    display: none !important;
  }

  /* Make social media and icon SVGs light in color in footer */
  .footer-content .social-icons__icon-wrapper,
  .footer-content .social-icons__icon-wrapper a,
  .footer-content .social-icons__icon-wrapper .social-icons__icon,
  .footer-content .social-icons__icon-wrapper .social-icons__icon svg,
  .footer-content .icon-block__media,
  .footer-content .icon-block__media svg {
    color: rgba(255, 255, 255, 0.7) !important;
  }

  .footer-content .social-icons__icon-wrapper .social-icons__icon svg,
  .footer-content .social-icons__icon-wrapper .social-icons__icon svg *,
  .footer-content .social-icons__icon-wrapper a svg,
  .footer-content .social-icons__icon-wrapper a svg *,
  .footer-content .icon-block__media svg,
  .footer-content .icon-block__media svg * {
    fill: rgba(255, 255, 255, 0.7) !important;
    stroke: rgba(255, 255, 255, 0.7) !important;
  }

  .footer-content .social-icons__icon-wrapper .social-icons__icon svg path,
  .footer-content .social-icons__icon-wrapper .social-icons__icon svg circle,
  .footer-content .social-icons__icon-wrapper .social-icons__icon svg rect,
  .footer-content .social-icons__icon-wrapper .social-icons__icon svg polygon,
  .footer-content .social-icons__icon-wrapper .social-icons__icon svg g,
  .footer-content .social-icons__icon-wrapper .social-icons__icon svg use,
  .footer-content .social-icons__icon-wrapper a svg path,
  .footer-content .social-icons__icon-wrapper a svg circle,
  .footer-content .social-icons__icon-wrapper a svg rect,
  .footer-content .social-icons__icon-wrapper a svg polygon,
  .footer-content .social-icons__icon-wrapper a svg g,
  .footer-content .social-icons__icon-wrapper a svg use,
  .footer-content .icon-block__media svg path,
  .footer-content .icon-block__media svg circle,
  .footer-content .icon-block__media svg rect,
  .footer-content .icon-block__media svg polygon,
  .footer-content .icon-block__media svg g {
    fill: rgba(255, 255, 255, 0.7) !important;
    stroke: rgba(255, 255, 255, 0.7) !important;
  }

  /* Additional rules for any nested elements */
  .footer-content .social-icons__icon-wrapper *,
  .footer-content .social-icons__icon-wrapper * svg,
  .footer-content .social-icons__icon-wrapper * svg * {
    color: rgba(255, 255, 255, 0.7) !important;
    fill: rgba(255, 255, 255, 0.7) !important;
    stroke: rgba(255, 255, 255, 0.7) !important;
  }

  /* Force light color using filter - apply to ALL social icon SVGs */
  .footer-content .social-icons__wrapper svg,
  .footer-content .social-icons__wrapper a svg,
  .footer-content .social-icons__icon-wrapper svg,
  .footer-content .social-icons__icon-wrapper a svg,
  .footer-content .social-icons__icon-wrapper .social-icons__icon,
  .footer-content .social-icons__icon-wrapper .social-icons__icon svg {
    filter: brightness(0) invert(1) opacity(0.7) !important;
    -webkit-filter: brightness(0) invert(1) opacity(0.7) !important;
  }
  
  /* Also target the wrapper class used in footer */
  .footer-content .footer-utilities__icons svg,
  .footer-content .footer-utilities__icons a svg {
    filter: brightness(0) invert(1) opacity(0.7) !important;
    -webkit-filter: brightness(0) invert(1) opacity(0.7) !important;
  }
  
  /* Global footer social icons - target all social icons anywhere in footer */
  footer .social-icons__wrapper svg,
  footer .social-icons__wrapper a svg,
  footer .social-icons__icon-wrapper svg,
  footer .social-icons__icon-wrapper a svg,
  footer .social-icons__icon-wrapper .social-icons__icon svg,
  footer .footer-utilities__icons svg,
  footer .footer-utilities__icons a svg,
  .section-wrapper footer .social-icons__wrapper svg,
  .section-wrapper footer .social-icons__icon-wrapper svg,
  .section-wrapper footer .social-icons__icon-wrapper a svg,
  footer svg.icon-default,
  footer .icon-default svg,
  footer .social-icons__icon.icon-default {
    filter: brightness(0) invert(1) opacity(0.7) !important;
    -webkit-filter: brightness(0) invert(1) opacity(0.7) !important;
  }

  /* Make payment logos under email input smaller */
  .footer-content .email-signup-block + .group-block .image-block,
  .footer-content .email-signup-block + .group-block .image-block__image {
    max-width: 45px !important;
    width: auto !important;
    height: auto !important;
  }

  .footer-content .email-signup-block + .group-block .image-block img {
    max-width: 45px !important;
    width: auto !important;
    height: auto !important;
    object-fit: contain !important;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.footer",
  "class": "section-wrapper",
  "tag": "footer",
  "blocks": [
    {
      "type": "_divider"
    },
    {
      "type": "@app"
    },
    {
      "type": "button"
    },
    {
      "type": "follow-on-shop"
    },
    {
      "type": "group"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "menu"
    },
    {
      "type": "payment-icons"
    },
    {
      "type": "text"
    },
    {
      "type": "logo"
    },
    {
      "type": "jumbo-text"
    },
    {
      "type": "social-links"
    },
    {
      "type": "email-signup"
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "t:names.footer",
      "category": "t:categories.footer",
      "settings": {
        "gap": 20,
        "color_scheme": "scheme-1",
        "padding-block-start": 36,
        "padding-block-end": 36
      },
      "blocks": {
        "newsletter-group": {
          "type": "group",
          "settings": {
            "content_direction": "column",
            "vertical_on_mobile": true,
            "horizontal_alignment": "flex-start",
            "vertical_alignment": "center",
            "gap": 6,
            "width": "fill",
            "inherit_color_scheme": true
          },
          "blocks": {
            "newsletter-heading": {
              "type": "text",
              "settings": {
                "text": "t:html_defaults.join_our_email_list",
                "width": "100%",
                "alignment": "left",
                "type_preset": "h3"
              }
            },
            "newsletter-text": {
              "type": "text",
              "settings": {
                "text": "t:html_defaults.get_exclusive_deals_and_early_access_to_new_products",
                "width": "100%",
                "alignment": "left",
                "type_preset": "rte"
              }
            }
          },
          "block_order": ["newsletter-heading", "newsletter-text"]
        },
        "newsletter-form": {
          "type": "email-signup",
          "settings": {
            "width": "fill"
          }
        }
      },
      "block_order": ["newsletter-group", "newsletter-form"]
    }
  ]
}
{% endschema %}
