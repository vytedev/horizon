<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
  data-template="{{ template.name }}"
>
  <head>
    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% comment %} This a way to wait for main content to load when navigating to a new page so that the view transitions can work consistently {% endcomment %}
    {% if settings.transition_to_main_product or settings.page_transition_enabled %}
      <link
        rel="expect"
        href="#MainContent"
        blocking="render"
        id="view-transition-render-blocker"
      >
    {% endif %}

    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}
    
    {% if template.name == 'index' or template.name == 'collection' or template.name == 'list-collections' or template.name == 'cart' or template.name == 'page' or template.name == 'search' or template.name == '404' %}
      <style>
        /* Vertical lines background for collection, collection list, cart, page, search, and 404 templates - equal spacing */
        html[data-template="collection"]::before,
        html[data-template="list-collections"]::before,
        html[data-template="cart"]::before,
        html[data-template="page"]::before,
        html[data-template="search"]::before,
        html[data-template="404"]::before {
          content: '';
          position: fixed;
          top: 0;
          left: 0;
          width: 100%;
          height: 100vh;
          pointer-events: none;
          z-index: -1 !important;
          background-image: repeating-linear-gradient(
            to right,
            transparent 0,
            transparent calc((100vw / 12) - 1px),
            rgba(128, 128, 128, 0.2) calc((100vw / 12) - 1px),
            rgba(128, 128, 128, 0.2) calc(100vw / 12)
          );
          background-size: calc(100vw / 12) 100%;
          box-shadow: inset 0 0 60px rgba(0, 0, 0, 0.08);
        }

        /* Vertical lines background only for collections section on index page */
        html[data-template="index"] .shopify-section:has([data-testid="collection-list"])::before,
        html[data-template="index"] .shopify-section:has(.section-resource-list)::before {
          content: '';
          position: absolute;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
          pointer-events: none;
          z-index: 0;
          background-image: repeating-linear-gradient(
            to right,
            transparent 0,
            transparent calc((100vw / 12) - 1px),
            rgba(128, 128, 128, 0.2) calc((100vw / 12) - 1px),
            rgba(128, 128, 128, 0.2) calc(100vw / 12)
          );
          background-size: calc(100vw / 12) 100%;
          box-shadow: inset 0 0 60px rgba(0, 0, 0, 0.08);
        }

        html[data-template="index"] .shopify-section:has([data-testid="collection-list"]),
        html[data-template="index"] .shopify-section:has(.section-resource-list) {
          position: relative;
        }

        /* Border top and bottom for collection section matching vertical lines style */
        html[data-template="index"] .shopify-section:has([data-testid="collection-list"]) .section,
        html[data-template="index"] .shopify-section:has(.section-resource-list) .section {
          border-top: 1px solid rgba(128, 128, 128, 0.2);
          border-bottom: 1px solid rgba(128, 128, 128, 0.2);
          box-shadow: 
            0 -1px 0 rgba(0, 0, 0, 0.03),
            0 1px 0 rgba(0, 0, 0, 0.03);
        }
        
        html[data-template="collection"],
        html[data-template="list-collections"],
        html[data-template="cart"],
        html[data-template="page"],
        html[data-template="search"],
        html[data-template="404"] {
          position: relative;
        }
      </style>
    {% endif %}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {% if template.name == 'collection' %}
      <style>
        /* Reduce gap between collection title and description in other brands page */
        body[data-template="collection"] [class*="group_cVg6Fm"],
        body[data-template="collection"] .group-block:has([data-block-id*="text_tqQTNE"]):has([data-block-id*="new_arrivals_description"]) {
          gap: 0 !important;
        }
        body[data-template="collection"] [data-block-id*="text_tqQTNE"] {
          margin-bottom: 0 !important;
          padding-bottom: 0 !important;
        }
        body[data-template="collection"] [data-block-id*="new_arrivals_description"] {
          margin-top: -8px !important;
          padding-top: 0 !important;
        }
        
        /* Add padding bottom to collection title and description container */
        body[data-template="collection"] [class*="group_cVg6Fm"],
        body[data-template="collection"] [class*="group_cVg6Fm"] .group-block-content,
        body[data-template="collection"] .section-content-wrapper > .group-block:nth-child(2),
        body[data-template="collection"] .section-content-wrapper > .group-block:nth-child(2) .group-block-content,
        body[data-template="collection"] .group-block:has(h2),
        body[data-template="collection"] .group-block:has(.text-block h2) {
          padding-bottom: 24px !important;
          margin-bottom: 24px !important;
        }
        
        /* Add border top to results-list element */
        body[data-template="collection"] results-list {
          border-top: 1px solid rgba(128, 128, 128, 0.2) !important;
        }
      </style>
    {% endif %}

    {{ content_for_header }}
  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}" data-template="{{ template.name }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    <script>
      // Inline header height calculation to prevent layout shift
      // Note: Updates in calculateHeaderGroupHeight() and updateTransparentHeaderOffset()utilities.js should be kept in sync with this function
      (function setHeaderHeighCustomProperties() {
        /*
         * Header calculation functions for maintaining CSS variables
         * Mimic calculateHeaderGroupHeight() in utilities.js
         */
        const header = document.querySelector('header-component');
        const headerGroup = document.querySelector('#header-group');
        const hasHeaderSection = headerGroup?.querySelector('.header-section');

        if (!header || !headerGroup) return;

        const headerHeight = header.offsetHeight;

        // Calculate the total height of the header group
        let headerGroupHeight = 0;
        const children = headerGroup.children;
        for (let i = 0; i < children.length; i++) {
          const element = children[i];
          if (element === header || !(element instanceof HTMLElement)) continue;
          headerGroupHeight += element.offsetHeight;
        }

        // Check for transparent header special case
        if (header.hasAttribute('transparent') && header.parentElement?.nextElementSibling) {
          headerGroupHeight += headerHeight;
        }

        // Set CSS variables
        document.body.style.setProperty('--header-height', `${headerHeight}px`);
        document.body.style.setProperty('--header-group-height', `${headerGroupHeight}px`);

        /**
         * Updates CSS custom properties for transparent header offset calculation
         * Mimic updateTransparentHeaderOffset() in utilities.js
         */

        if (!hasHeaderSection || !header?.hasAttribute('transparent')) {
          document.body.style.setProperty('--transparent-header-offset-boolean', '0');
          return;
        }

        const hasImmediateSection = hasHeaderSection.nextElementSibling?.classList.contains('shopify-section');

        const shouldApplyOffset = !hasImmediateSection ? '1' : '0';
        document.body.style.setProperty('--transparent-header-offset-boolean', shouldApplyOffset);
      })();
    </script>

    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}"
    >
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}

    <script>
      // Add stroke color to SVG icons in groups while preserving existing stroke-width
      (function addStrokeToGroupIcons() {
        function applyStrokeToIcons() {
          const groupBlocks = document.querySelectorAll('.group-block, .group-block-content');
          
          groupBlocks.forEach(group => {
            const svgs = group.querySelectorAll('.icon-block__media svg');
            
            svgs.forEach(svg => {
              // Add stroke color, preserve existing stroke-width if present
              svg.setAttribute('stroke', '#f5f5f5');
              // Don't modify stroke-width - keep whatever is already there
              
              // Also apply to all child elements (paths, circles, etc.)
              const children = svg.querySelectorAll('path, circle, rect, polygon, line, polyline, ellipse, g, use');
              children.forEach(child => {
                // Store existing stroke-width before setting stroke
                const existingStrokeWidth = child.getAttribute('stroke-width');
                child.setAttribute('stroke', '#f5f5f5');
                // Restore stroke-width if it existed
                if (existingStrokeWidth) {
                  child.setAttribute('stroke-width', existingStrokeWidth);
                }
              });
            });
          });
        }

        // Run on page load
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', applyStrokeToIcons);
        } else {
          applyStrokeToIcons();
        }

        // Also run when new content is added (for dynamic sections)
        const observer = new MutationObserver(applyStrokeToIcons);
        observer.observe(document.body, {
          childList: true,
          subtree: true
        });
      })();

      // Product description show more functionality
      (function productDescriptionShowMore() {
        function initProductDescription() {
          // Find product details section
          const productDetails = document.querySelector('.product-details');
          if (!productDetails) return;
          
          // Find the rte text block in product details (this should be the description)
          let productDescription = productDetails.querySelector('.text-block.rte') || 
                                   productDetails.querySelector('rte-formatter.text-block.rte');
          
          // If not found, try finding by position - it should be after the title
          if (!productDescription) {
            const allTextBlocks = productDetails.querySelectorAll('.text-block, rte-formatter');
            // Find the rte block (description comes after title, before price)
            allTextBlocks.forEach(block => {
              if (block.classList.contains('rte') && !block.classList.contains('text-block--text_vendor')) {
                productDescription = block;
              }
            });
          }
          
          if (!productDescription) {
            return;
          }
          
          // Only apply on desktop (750px and above)
          if (window.innerWidth < 750) {
            productDescription.classList.add('expanded');
            return;
          }
          
          // Temporarily remove max-height to measure full height
          const originalMaxHeight = productDescription.style.maxHeight;
          const originalClassList = productDescription.classList.contains('expanded');
          productDescription.style.maxHeight = 'none';
          productDescription.classList.add('expanded');
          const originalHeight = productDescription.scrollHeight;
          productDescription.style.maxHeight = originalMaxHeight;
          if (!originalClassList) {
            productDescription.classList.remove('expanded');
          }
          
          const maxHeight = 200;
          
          if (originalHeight <= maxHeight) {
            productDescription.classList.add('expanded');
            return;
          }
          
          // Check if button already exists
          const existingButton = productDescription.parentNode.querySelector('.product-description-show-more');
          if (existingButton) {
            return;
          }
          
          // Create show more button with text and chevron icon
          const showMoreButton = document.createElement('button');
          showMoreButton.className = 'product-description-show-more';
          showMoreButton.setAttribute('type', 'button');
          showMoreButton.setAttribute('aria-expanded', 'false');
          showMoreButton.setAttribute('aria-label', 'Show more description');
          
          // Add "Show More" text (capitalized, not uppercase)
          const textSpan = document.createElement('span');
          textSpan.textContent = 'Show More';
          textSpan.className = 'show-more-text';
          showMoreButton.appendChild(textSpan);
          
          // Add chevron down SVG icon
          const chevronSvg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
          chevronSvg.setAttribute('width', '16');
          chevronSvg.setAttribute('height', '16');
          chevronSvg.setAttribute('viewBox', '0 0 20 20');
          chevronSvg.setAttribute('fill', 'none');
          chevronSvg.setAttribute('xmlns', 'http://www.w3.org/2000/svg');
          
          const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
          path.setAttribute('d', 'M5 7.5L10 12.5L15 7.5');
          path.setAttribute('stroke', 'currentColor');
          path.setAttribute('stroke-width', '2');
          path.setAttribute('stroke-linecap', 'round');
          path.setAttribute('stroke-linejoin', 'round');
          
          chevronSvg.appendChild(path);
          showMoreButton.appendChild(chevronSvg);
          
          // Add button after the description
          productDescription.parentNode.insertBefore(showMoreButton, productDescription.nextSibling);
          
          // Toggle functionality
          showMoreButton.addEventListener('click', function() {
            const isExpanded = productDescription.classList.toggle('expanded');
            showMoreButton.classList.toggle('expanded', isExpanded);
            textSpan.textContent = isExpanded ? 'Show Less' : 'Show More';
            showMoreButton.setAttribute('aria-expanded', isExpanded);
            showMoreButton.setAttribute('aria-label', isExpanded ? 'Show less description' : 'Show more description');
          });
        }
        
        // Run on page load with a delay to ensure DOM is ready
        function runInit() {
          setTimeout(initProductDescription, 300);
        }
        
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', runInit);
        } else {
          runInit();
        }
        
        // Also run when window is resized
        let resizeTimer;
        window.addEventListener('resize', function() {
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(function() {
            const productDetails = document.querySelector('.product-details');
            if (productDetails) {
              const productDescription = productDetails.querySelector('.text-block.rte') || 
                                         productDetails.querySelector('rte-formatter.text-block.rte');
              if (productDescription) {
                const showMoreButton = productDescription.parentNode.querySelector('.product-description-show-more');
                if (showMoreButton) {
                  showMoreButton.remove();
                }
                productDescription.classList.remove('expanded');
                initProductDescription();
              }
            }
          }, 250);
        });
      })();
    </script>
  </body>
</html>
