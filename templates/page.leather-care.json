                "text_eRkriT": {
                  "type": "text",
                  "name": "t:names.heading",
                  "settings": {
                    "text": "<h2>Elaign, Founder of Bag Reluxe</h2>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
                    "type_preset": "h3",
                    "font": "var(--font-heading--family)",
                    "font_size": "2.5rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
